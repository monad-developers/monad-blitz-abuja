# ──────────────────────────────────────────────────────────────
# Monad Escrow — Environment Configuration
# Copy this to .env and fill in real values
# ──────────────────────────────────────────────────────────────

# Relayer wallet private key (WITH 0x prefix)
# This wallet pays gas and MON for all demo escrows
RELAYER_PRIVATE_KEY=0xyour_private_key_here

# Deployed MonadEscrow contract address (set after deploying)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Fixed demo seller address — one seller for ALL demo escrows
# This is the "Campus Vendor" wallet you control
DEMO_SELLER_ADDRESS=0xyour_demo_seller_address_here

# Monad Testnet RPC (chain ID 10143)
RPC_URL=https://testnet-rpc.monad.xyz/

# Server port
PORT=3001

# Default escrow amount in MON (if client doesn't specify)
DEFAULT_ESCROW_AMOUNT=0.001
