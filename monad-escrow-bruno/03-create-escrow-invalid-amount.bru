meta {
  name: Create Escrow - Zero Amount (should fail)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/escrow/create
  body: json
  auth: none
}

body:json {
  {
    "buyerAddress": "{{testBuyerAddress}}",
    "title": "Invalid Test",
    "amountMON": "0"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("returns an error message", function() {
    expect(res.getBody()).to.have.property('error');
  });
}

docs {
  Zero-value escrows should be rejected in the backend before ever reaching
  the chain — cheap to catch here rather than burning a real relayer
  transaction (and a nonce) on something that was always going to revert.
}
